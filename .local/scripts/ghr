#!/bin/bash
# ghr - github release manager

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ghr"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghr"
BIN_DIR="${HOME}/.local/bin"
API="https://api.github.com/repos"

mkdir -p "$CACHE_DIR" "$CONFIG_DIR" "$BIN_DIR"

# Anonymous GitHub API is 60 req/hour per IP and a fan-out spends one per tool,
# so a full update can run dry mid-flight. A token raises that to 5000.
export GHR_TOKEN="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
GHR_TOKEN_TRIED=0

# gh is a fallback, not a dependency: it is only consulted once the anonymous
# quota is provably too small for the run about to happen.
resolve_token() {
  [ -n "$GHR_TOKEN" ] && return 0
  [ "$GHR_TOKEN_TRIED" = 1 ] && return 1
  GHR_TOKEN_TRIED=1
  command -v gh >/dev/null 2>&1 || return 1
  GHR_TOKEN=$(gh auth token 2>/dev/null)
  [ -n "$GHR_TOKEN" ]
}

# Asset downloads deliberately stay anonymous: browser_download_url redirects to
# a CDN host that rejects a forwarded Authorization header.
gh_api() {
  if [ -n "$GHR_TOKEN" ]; then
    curl -sf -H "Authorization: Bearer $GHR_TOKEN" "$API/$1"
  else
    curl -sf "$API/$1"
  fi
}
export -f gh_api
export API

# Checked before a fan-out rather than discovered halfway through it. The
# rate_limit endpoint does not itself count against the quota.
ensure_quota() {
  local needed="$1"
  local core remaining reset
  core=$(curl -sf "https://api.github.com/rate_limit") || return 0
  remaining=$(echo "$core" | jq -r '.resources.core.remaining')
  [ "$remaining" -ge "$needed" ] && return 0

  reset=$(echo "$core" | jq -r '.resources.core.reset')
  if resolve_token; then
    echo "GitHub quota is $remaining, this run needs up to $needed. Using gh token."
  else
    echo "GitHub quota is $remaining, this run needs up to $needed." >&2
    echo "Resets at $(date -d "@$reset" '+%H:%M'). Set GITHUB_TOKEN, or install gh, for 5000/hour." >&2
  fi
}

PROFILE_FILE="$CONFIG_DIR/profile"
if [ -f "$PROFILE_FILE" ]; then
  GHR_PROFILE=$(cat "$PROFILE_FILE")
else
  read -r -e -i "$(hostname)" -p "Profile name: " GHR_PROFILE
  GHR_PROFILE="${GHR_PROFILE:-$(hostname)}"
  echo "$GHR_PROFILE" >"$PROFILE_FILE"
fi
MANIFEST="$CONFIG_DIR/manifest-${GHR_PROFILE}.json"

get_dir() { echo "$CACHE_DIR/$(echo "$1" | tr '/' '_')"; }

manifest_read() {
  [ -f "$MANIFEST" ] && cat "$MANIFEST" || echo "[]"
}

# Atomically write stdin to the manifest. Resolves symlinks so a stowed
# manifest stays a symlink instead of being replaced with a regular file by mv.
manifest_write() {
  local target
  target=$(readlink -f "$MANIFEST" 2>/dev/null || echo "$MANIFEST")
  local tmp="${target}.tmp"
  cat >"$tmp" && mv "$tmp" "$target"
}

manifest_upsert() {
  local repo="$1" asset="$2" version="$3" links_json="$4"
  manifest_read | jq \
    --arg repo "$repo" \
    --arg asset "$asset" \
    --arg version "$version" \
    --argjson links "$links_json" \
    '[.[] | select(.repo != $repo)] + [{repo: $repo, asset: $asset, version: $version, links: $links}] | sort_by(.repo)' \
    | manifest_write
}

# Platform vocabularies, as "canonical:synonym synonym ...". Upstreams rename
# x86_64 to amd64 between releases, so membership matters, not spelling.
# Bare "x86" is deliberately absent: it would match inside "x86_64".
ARCH_CLASSES=(
  "x86_64:x86_64 x86-64 amd64 x64"
  "aarch64:aarch64 arm64 armv8"
  "arm:arm armv7 armv6 armhf"
  "i686:i686 i386"
)
OS_CLASSES=(
  "linux:linux"
  "darwin:darwin macos apple osx"
  "windows:windows"
  "freebsd:freebsd"
)
LIBC_CLASSES=(
  "musl:musl"
  "gnu:gnu glibc"
)

# Whole-token match, so "arm" does not match "arm64" and "gnu" does not match
# "gnutls".
has_token() {
  printf '%s' "$1" | grep -qiE "(^|[^a-z0-9])$2([^a-z0-9]|\$)"
}

# Print the canonical class a string declares, or nothing if it declares none.
classify() {
  local name="$1"
  shift
  local entry member
  for entry in "$@"; do
    for member in ${entry#*:}; do
      if has_token "$name" "$member"; then
        echo "${entry%%:*}"
        return 0
      fi
    done
  done
}

# Re-derived every run and never written to the manifest. A stored copy can
# drift out of sync with the machine, which is how a wrong-arch binary survives.
HOST_ARCH=$(classify "$(uname -m)" "${ARCH_CLASSES[@]}")
HOST_OS=$(classify "$(uname -s)" "${OS_CLASSES[@]}")

# Reject only assets that positively name a different platform. Naming nothing
# recognizable is not disqualifying: upstreams invent spellings constantly
# ("linux64" tokenizes as neither), and verify_arch is the real backstop.
host_compatible() {
  local declared
  declared=$(classify "$1" "${ARCH_CLASSES[@]}")
  [ -n "$declared" ] && [ -n "$HOST_ARCH" ] && [ "$declared" != "$HOST_ARCH" ] && return 1
  declared=$(classify "$1" "${OS_CLASSES[@]}")
  [ -n "$declared" ] && [ -n "$HOST_OS" ] && [ "$declared" != "$HOST_OS" ] && return 1
  return 0
}

# True unless both strings declare a class from this vocabulary and disagree.
# Silence on either side is fine; upstreams add and drop tokens between releases.
agrees_on() {
  local stored="$1" candidate="$2"
  shift 2
  local s c
  s=$(classify "$stored" "$@")
  c=$(classify "$candidate" "$@")
  [ -z "$s" ] || [ -z "$c" ] || [ "$s" = "$c" ]
}

# Checksums, signatures and provenance sit beside the real assets and carry the
# same platform tokens, so they pass every filter below unless dropped here.
is_sidecar() {
  case "$1" in
  *.sha256 | *.sha256sum | *.sha512 | *.sha1 | *.md5) return 0 ;;
  *.asc | *.sig | *.pem | *.cert | *.sbom) return 0 ;;
  *.json | *.jsonl | *.txt) return 0 ;;
  *) return 1 ;;
  esac
}

# Query for the similarity ranking. Version tokens come out because they
# changed; platform tokens come out because host_compatible already guaranteed
# them, and a stale arch token from a poisoned record can only prevent a match.
ranking_query() {
  local entry member pat=""
  for entry in "${ARCH_CLASSES[@]}" "${OS_CLASSES[@]}"; do
    for member in ${entry#*:}; do
      pat="$pat|$member"
    done
  done
  # Looped rather than /g: each match eats the separator on both sides, so
  # adjacent tokens ("aarch64-apple-darwin") need a rescan to all come out.
  echo "$1" | sed -E 's/v?[0-9]+(\.[0-9]+)+//g' |
    sed -E ":a;s/(^|[^a-zA-Z0-9])(${pat#|})([^a-zA-Z0-9]|\$)/\1\3/I;ta"
}

# Rewrite the stored name for a new version. Tags and asset names disagree about
# the "v" prefix, so try both spellings.
version_substitutions() {
  local stored="$1" old="$2" new="$3"
  [ -z "$old" ] && return
  echo "${stored//$old/$new}"
  echo "${stored//${old#v}/${new#v}}"
}

# Pick the asset in a new release corresponding to the one the user installed.
# Descends a confidence ladder and declines rather than guessing at the bottom,
# because a similarity ranking always returns something whether or not it is
# right. Prints the chosen name; returns 1 for "no confident answer".
select_asset() {
  local stored="$1" available="$2" old_ver="$3" new_ver="$4"

  # The host is the one input that cannot have been poisoned by an earlier bad
  # match, so it gates every rung below, the exact-name rung included. Without
  # that, one wrong pick is written back to the manifest and repeats forever.
  local viable
  viable=$(echo "$available" | while IFS= read -r a; do
    [ -n "$a" ] && ! is_sidecar "$a" && host_compatible "$a" && echo "$a"
  done)
  [ -z "$viable" ] && return 1

  if ! host_compatible "$stored"; then
    echo "  note: recorded asset $stored is not for this host, re-selecting" >&2
  fi

  # The name did not change.
  if echo "$viable" | grep -qxF "$stored"; then
    echo "$stored"
    return 0
  fi

  # The name changed only by version. Nothing is parsed, so this is correct by
  # construction for any naming scheme whose template held still.
  local guess
  while IFS= read -r guess; do
    [ -z "$guess" ] && continue
    if echo "$viable" | grep -qxF "$guess"; then
      echo "$guess"
      return 0
    fi
  done < <(version_substitutions "$stored" "$old_ver" "$new_ver")

  # Only one asset can run here, so there is nothing left to disambiguate. This
  # is what survives an upstream renaming its assets wholesale.
  if [ "$(echo "$viable" | wc -l)" -eq 1 ]; then
    echo "$viable"
    return 0
  fi

  # Several will run. The stored name says which flavour was wanted.
  local narrowed
  narrowed=$(echo "$viable" | while IFS= read -r a; do
    agrees_on "$stored" "$a" "${LIBC_CLASSES[@]}" && echo "$a"
  done)
  [ -z "$narrowed" ] && narrowed="$viable"
  if [ "$(echo "$narrowed" | wc -l)" -eq 1 ]; then
    echo "$narrowed"
    return 0
  fi

  # Still ambiguous, so fall back to ranking by similarity to the stored name.
  # Everything left runs here, so this only chooses a flavour, never an arch.
  local query candidate
  query=$(ranking_query "$stored")
  while IFS= read -r candidate; do
    if [ -n "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done < <(echo "$narrowed" | fzf --filter="$query" --no-sort)

  return 1
}

# Whatever the filename claimed, check what we actually got. This is the only
# rung that survives an upstream renaming scheme wholesale.
verify_arch() {
  local path="$1"
  command -v file >/dev/null 2>&1 || return 0

  # -L so a symlink is judged by its target, not reported as "symbolic link to".
  local desc
  desc=$(file -bL "$path")
  case "$desc" in
  *ELF* | *Mach-O*) ;;
  *) return 0 ;;
  esac

  local declared
  declared=$(classify "$desc" "${ARCH_CLASSES[@]}")
  [ -z "$declared" ] || [ -z "$HOST_ARCH" ] && return 0
  [ "$declared" = "$HOST_ARCH" ]
}

# Matches a binary's path inside an extracted archive, where names carry no
# platform tokens (an archive is already platform-specific). Asset selection
# uses select_asset instead.
fuzzy_match_name() {
  local stored="$1"
  local available="$2"

  local exact
  exact=$(echo "$available" | grep -xF "$stored")
  if [ -n "$exact" ]; then
    echo "$exact"
    return 0
  fi

  local query
  query=$(echo "$stored" | sed -E 's/v?[0-9]+(\.[0-9]+)+//g')
  local match
  match=$(echo "$available" | fzf --filter="$query" --no-sort | head -1)

  [ -n "$match" ] || return 1
  echo "$match"
}

list_extracted_files() {
  local dir="$1" archive_name="$2"
  find "$dir" -type f \
    -not -name ".repo" -not -name ".version" -not -name "$archive_name" \
    -printf '%P\n'
}

fuzzy_match_binary() {
  local stored="$1" dir="$2" archive_name="$3"
  local available
  available=$(list_extracted_files "$dir" "$archive_name" | while read -r f; do
    [ -x "$dir/$f" ] && echo "$f"
  done)
  fuzzy_match_name "$stored" "$available"
}

extract_asset() {
  local dir="$1" name="$2"
  case "$name" in
  *.tar.gz | *.tgz) tar -xzf "$dir/$name" -C "$dir" ;;
  *.zip) unzip -oq "$dir/$name" -d "$dir" ;;
  *.gz)
    gunzip -kf "$dir/$name"
    chmod +x "$dir/${name%.gz}"
    ;;
  *) chmod +x "$dir/$name" ;;
  esac
}

write_cache_meta() {
  local dir="$1" repo="$2" ver="$3"
  echo "$repo" >"$dir/.repo"
  echo "$ver" >"$dir/.version"
}

prompt_symlink() {
  local binary_path="$1"
  local default
  default="$BIN_DIR/$(basename "$binary_path")"
  local symlink_path

  # Caller captures stdout via $(...); route readline I/O through /dev/tty so
  # the editable prompt is actually visible.
  read -r -e -i "$default" -p "Symlink for $binary_path: " symlink_path </dev/tty 2>/dev/tty
  echo "${symlink_path:-$default}"
}

# Create parent dir and symlink, escalating to sudo when the user can't
# write. Tries without sudo first to avoid a needless prompt.
safe_ln() {
  local src="$1" dst="$2" dir
  dir=$(dirname "$dst")
  if mkdir -p "$dir" 2>/dev/null && ln -sf "$src" "$dst" 2>/dev/null; then
    return 0
  fi
  sudo mkdir -p "$dir" && sudo ln -sf "$src" "$dst"
}

# True if any link dst in the given manifest JSON is in a non-writable dir.
manifest_needs_sudo() {
  local manifest="$1"
  local dst
  while IFS= read -r dst; do
    [ -z "$dst" ] && continue
    [ -w "$(dirname "$dst")" ] || return 0
  done < <(echo "$manifest" | jq -r '.[].links | values[]')
  return 1
}

# True if any dst in the given links JSON object is in a non-writable dir.
links_need_sudo() {
  local links_json="$1"
  local dst
  while IFS= read -r dst; do
    [ -z "$dst" ] && continue
    [ -w "$(dirname "$dst")" ] || return 0
  done < <(echo "$links_json" | jq -r 'values[]')
  return 1
}

pick_executable() {
  local dir="$1" archive_name="$2"

  local exec_files=()
  local other_files=()

  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ -x "$dir/$f" ]; then
      exec_files+=("$f")
    else
      other_files+=("$f")
    fi
  done < <(list_extracted_files "$dir" "$archive_name" | sort)

  # If the archive has any executables, only offer those. Large tarballs
  # (e.g. nvim) have thousands of non-executable data files that would flood
  # the prompt, and the user almost always wants an executable anyway.
  local all
  if [ "${#exec_files[@]}" -gt 0 ]; then
    all=("${exec_files[@]}")
  else
    all=("${other_files[@]}")
  fi

  # Caller captures stdout via $(...); send the menu + prompt to /dev/tty and
  # read from /dev/tty so only the final selection lands on stdout.
  {
    local idx=1
    echo ""
    echo "Files:"
    for f in "${all[@]}"; do
      if [ -x "$dir/$f" ]; then
        printf "  %d  %s  [+x]\n" "$idx" "$f"
      else
        printf "  %d  %s\n" "$idx" "$f"
      fi
      idx=$((idx + 1))
    done
    printf "\nSelect executables [1] (e.g. 1 3, 2-4, all): "
  } >/dev/tty

  local input
  read -r input </dev/tty
  input="${input:-1}"

  local indices=() i
  if [ "$input" = "a" ] || [ "$input" = "all" ]; then
    for ((i = 1; i <= ${#all[@]}; i++)); do indices+=("$i"); done
  else
    local tok
    for tok in ${input//,/ }; do
      if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        for ((i = BASH_REMATCH[1]; i <= BASH_REMATCH[2]; i++)); do indices+=("$i"); done
      elif [[ "$tok" =~ ^[0-9]+$ ]]; then
        indices+=("$tok")
      else
        echo "Invalid selection: $tok" >&2
        return 1
      fi
    done
  fi

  local picked=() seen=" "
  local n
  for n in "${indices[@]}"; do
    if [ "$n" -lt 1 ] || [ "$n" -gt "${#all[@]}" ]; then
      echo "Invalid selection: $n" >&2
      return 1
    fi
    case "$seen" in *" $n "*) continue ;; esac
    seen+="$n "
    picked+=("${all[$((n - 1))]}")
  done

  if [ "${#picked[@]}" -eq 0 ]; then
    echo "Nothing selected" >&2
    return 1
  fi

  printf '%s\n' "${picked[@]}"
}

install_repo() {
  local repo="$1"
  local dir
  dir=$(get_dir "$repo")
  mkdir -p "$dir"

  ensure_quota 1

  local release
  release=$(gh_api "$repo/releases/latest") || {
    echo "No releases for $repo" >&2
    return 1
  }

  local ver
  ver=$(echo "$release" | jq -r '.tag_name')
  echo "Latest: $ver"

  local assets
  assets=$(echo "$release" | jq -r '.assets[] | "\(.name)\t\(.browser_download_url)"')

  [ -z "$assets" ] && {
    echo "No assets" >&2
    return 1
  }

  local asset_count
  asset_count=$(echo "$assets" | wc -l)
  echo "$assets" | cut -f1 | nl
  printf "Select [1]: "
  read -r n
  n="${n:-1}"

  if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -lt 1 ] || [ "$n" -gt "$asset_count" ]; then
    echo "Invalid selection: $n" >&2
    return 1
  fi

  local url name
  url=$(echo "$assets" | sed -n "${n}p" | cut -f2)
  name=$(echo "$assets" | sed -n "${n}p" | cut -f1)

  echo "Downloading $name..."
  curl -L --progress-bar -o "$dir/$name" "$url"
  write_cache_meta "$dir" "$repo" "$ver"

  local binaries=()
  case "$name" in
  *.tar.gz | *.tgz | *.zip)
    echo "Extracting..."
    extract_asset "$dir" "$name"
    local picked
    picked=$(pick_executable "$dir" "$name") || return 1
    mapfile -t binaries <<<"$picked"
    ;;
  *.gz)
    echo "Extracting..."
    extract_asset "$dir" "$name"
    binaries=("${name%.gz}")
    ;;
  *)
    extract_asset "$dir" "$name"
    binaries=("$name")
    ;;
  esac

  local links_json="{}"
  local binary symlink_path
  for binary in "${binaries[@]}"; do
    # Archives don't always carry the +x bit (and unzip won't add it), so a
    # picked binary can land non-executable. restore_single chmods; match it here.
    chmod +x "$dir/$binary"

    # Advisory only: an explicit pick can legitimately be cross-arch, unlike the
    # unattended update path where the same mismatch is always a bug.
    verify_arch "$dir/$binary" || echo "warning: $binary is not $HOST_ARCH" >&2

    symlink_path=$(prompt_symlink "$binary")
    if ! safe_ln "$dir/$binary" "$symlink_path"; then
      echo "Failed to create symlink: $symlink_path" >&2
      return 1
    fi
    links_json=$(echo "$links_json" | jq -c --arg s "$binary" --arg d "$symlink_path" '. + {($s): $d}')
  done

  manifest_upsert "$repo" "$name" "$ver" "$links_json"

  echo "Installed $repo ($ver) -> $(echo "$links_json" | jq -r 'values | join(", ")')"
}

all_links_valid() {
  local links_json="$1"
  local dst
  while IFS= read -r dst; do
    [ -e "$dst" ] || return 1
    # "Up to date" has to mean runnable, not merely present. Without this a
    # wrong-arch binary is reported healthy forever and never re-selected.
    verify_arch "$dst" || return 1
  done < <(echo "$links_json" | jq -r '.[]')
  return 0
}

# Downloads latest release and creates symlinks from a manifest entry.
# Writes result TSV (repo, asset, ver, links_json) to $result_file.
# Status messages go to stdout/stderr normally.
restore_single() {
  local repo="$1" asset="$2" links_json="$3" prefix="$4" result_file="$5" quiet="${6:-}"

  local dir
  dir=$(get_dir "$repo")
  mkdir -p "$dir"

  local release
  release=$(gh_api "$repo/releases/latest") || {
    echo "$prefix $repo ... FAIL (no releases or quota exhausted)" >&2
    return 1
  }

  local ver
  ver=$(echo "$release" | jq -r '.tag_name')

  local old_ver
  old_ver=$(cat "$dir/.version" 2>/dev/null)

  if [ "$old_ver" = "$ver" ] && all_links_valid "$links_json"; then
    [ -z "$quiet" ] && echo "$prefix $repo ... ok (up to date)"
    return 0
  fi

  local available
  available=$(echo "$release" | jq -r '.assets[].name')

  local matched_asset
  matched_asset=$(select_asset "$asset" "$available" "$old_ver" "$ver") || {
    echo "$prefix $repo ... FAIL (no confident asset match, run ghr install manually)" >&2
    return 1
  }

  local url
  url=$(echo "$release" | jq -r --arg name "$matched_asset" '.assets[] | select(.name == $name) | .browser_download_url')

  # Stage the whole update before touching the cache dir, so a release that
  # fails verification leaves the working binary and its symlinks alone.
  local stage="$dir/.stage"
  rm -rf "$stage"
  mkdir -p "$stage"

  if ! curl -sfL -o "$stage/$matched_asset" "$url"; then
    rm -rf "$stage"
    echo "$prefix $repo ... FAIL (download error)" >&2
    return 1
  fi
  extract_asset "$stage" "$matched_asset"

  local src dst actual_src
  while IFS=$'\t' read -r src dst; do
    actual_src=$(fuzzy_match_binary "$src" "$stage" "$matched_asset") || actual_src="$src"
    if [ ! -e "$stage/$actual_src" ]; then
      rm -rf "$stage"
      echo "$prefix $repo ... FAIL ($src missing from $matched_asset, keeping $old_ver)" >&2
      return 1
    fi
    chmod +x "$stage/$actual_src" 2>/dev/null
    if ! verify_arch "$stage/$actual_src"; then
      rm -rf "$stage"
      echo "$prefix $repo ... FAIL ($matched_asset is not $HOST_ARCH, keeping $old_ver)" >&2
      return 1
    fi
  done < <(echo "$links_json" | jq -r 'to_entries[] | "\(.key)\t\(.value)"')

  # Verified. Rename rather than copy, so an in-use executable (ETXTBSY) and a
  # partial download can't clobber a good binary.
  mv "$stage/$matched_asset" "$dir/$matched_asset"
  rm -rf "$stage"
  write_cache_meta "$dir" "$repo" "$ver"
  extract_asset "$dir" "$matched_asset"

  local new_links_json="{}"
  while IFS=$'\t' read -r src dst; do
    actual_src=$(fuzzy_match_binary "$src" "$dir" "$matched_asset") || actual_src="$src"
    chmod +x "$dir/$actual_src"
    if ! safe_ln "$dir/$actual_src" "$dst"; then
      echo "$prefix $repo ... FAIL (symlink error: $dst)" >&2
      return 1
    fi
    new_links_json=$(echo "$new_links_json" | jq -c --arg s "$actual_src" --arg d "$dst" '. + {($s): $d}')
  done < <(echo "$links_json" | jq -r 'to_entries[] | "\(.key)\t\(.value)"')

  printf "%s\t%s\t%s\t%s" "$repo" "$matched_asset" "$ver" "$new_links_json" >"$result_file"
  echo "$prefix $repo $old_ver -> $ver"
}

apply_restore_results() {
  local tmpdir="$1" count="$2"
  local i=0
  while [ "$i" -lt "$count" ]; do
    if [ -s "$tmpdir/$i" ]; then
      IFS=$'\t' read -r repo asset ver links_json <"$tmpdir/$i"
      manifest_upsert "$repo" "$asset" "$ver" "$links_json"
    fi
    i=$((i + 1))
  done
}

restore_all() {
  local quiet="${1:-}"
  local manifest
  manifest=$(manifest_read)
  local total
  total=$(echo "$manifest" | jq 'length')

  [ "$total" -eq 0 ] && {
    echo "Nothing to restore (manifest empty)"
    return
  }

  # Worst case is one request per tool in phase 1 plus one more per outdated tool.
  ensure_quota $((total * 2))

  [ -z "$quiet" ] && echo "Restoring $total tools from manifest..." && echo ""

  local tmpdir
  tmpdir=$(mktemp -d)

  # Phase 1: parallel version check. Writes "current"|"outdated"|"fail" to check.$i
  local i=0
  while [ "$i" -lt "$total" ]; do
    {
      read -r repo links_json < <(echo "$manifest" | jq -r ".[$i] | [.repo, (.links | tojson)] | @tsv")
      remote_ver=$(gh_api "$repo/releases/latest" | jq -r '.tag_name' 2>/dev/null)
      if [ -z "$remote_ver" ] || [ "$remote_ver" = "null" ]; then
        echo "fail" >"$tmpdir/check.$i"
      else
        dir=$(get_dir "$repo")
        local_ver=$(cat "$dir/.version" 2>/dev/null)
        if [ "$local_ver" = "$remote_ver" ] && all_links_valid "$links_json"; then
          echo "current" >"$tmpdir/check.$i"
        else
          echo "outdated" >"$tmpdir/check.$i"
        fi
      fi
    } &
    i=$((i + 1))
  done
  wait

  # Sudo only if some OUTDATED tool's links point to a non-writable dir.
  local outdated_needs_sudo=false
  i=0
  while [ "$i" -lt "$total" ]; do
    if [ "$(cat "$tmpdir/check.$i" 2>/dev/null)" = "outdated" ]; then
      local links_json
      links_json=$(echo "$manifest" | jq -c ".[$i].links")
      if links_need_sudo "$links_json"; then
        outdated_needs_sudo=true
        break
      fi
    fi
    i=$((i + 1))
  done

  if $outdated_needs_sudo; then
    [ -z "$quiet" ] && echo "Some tools symlink to system dirs; caching sudo credentials..."
    sudo -v || {
      echo "sudo required but unavailable" >&2
      rm -rf "$tmpdir"
      return 1
    }
  fi

  # Phase 2: spawn restore_single only for outdated; synthesize logs for the rest.
  local pids=()
  local failed=0
  i=0
  while [ "$i" -lt "$total" ]; do
    read -r repo asset links_json < <(echo "$manifest" | jq -r ".[$i] | [.repo, .asset, (.links | tojson)] | @tsv")
    case "$(cat "$tmpdir/check.$i" 2>/dev/null)" in
    current)
      [ -z "$quiet" ] && echo "[$((i + 1))/$total] $repo ... ok (up to date)" >"$tmpdir/$i.log"
      ;;
    fail)
      echo "[$((i + 1))/$total] $repo ... FAIL (no releases)" >"$tmpdir/$i.log"
      failed=$((failed + 1))
      ;;
    outdated)
      restore_single "$repo" "$asset" "$links_json" "[$((i + 1))/$total]" "$tmpdir/$i" "$quiet" \
        >"$tmpdir/$i.log" 2>&1 &
      pids+=($!)
      ;;
    esac
    i=$((i + 1))
  done

  for pid in "${pids[@]}"; do
    wait "$pid" || failed=$((failed + 1))
  done

  i=0
  while [ "$i" -lt "$total" ]; do
    cat "$tmpdir/$i.log" 2>/dev/null
    i=$((i + 1))
  done

  apply_restore_results "$tmpdir" "$total"

  local updated=0
  i=0
  while [ "$i" -lt "$total" ]; do
    [ -s "$tmpdir/$i" ] && updated=$((updated + 1))
    i=$((i + 1))
  done
  rm -rf "$tmpdir"

  echo ""
  if [ -n "$quiet" ]; then
    if [ "$updated" -eq 0 ] && [ "$failed" -eq 0 ]; then
      echo "All $total tools up to date"
    else
      echo "Updated $updated/$total tools"
    fi
  else
    echo "Restored $((total - failed))/$total tools"
  fi
  [ "$failed" -gt 0 ] && return 1
  return 0
}

update_repo() {
  local repo="$1"
  local manifest
  manifest=$(manifest_read)

  local entry
  entry=$(echo "$manifest" | jq -r --arg repo "$repo" '.[] | select(.repo == $repo)')

  [ -z "$entry" ] && {
    echo "$repo not in manifest. Use 'ghr install $repo' first." >&2
    return 1
  }

  ensure_quota 1

  local asset links_json
  asset=$(echo "$entry" | jq -r '.asset')
  links_json=$(echo "$entry" | jq -c '.links')

  local tmpdir
  tmpdir=$(mktemp -d)
  restore_single "$repo" "$asset" "$links_json" "[1/1]" "$tmpdir/0"
  apply_restore_results "$tmpdir" 1
  rm -rf "$tmpdir"
}

remove_repo() {
  local repo="$1"
  if [ -z "$repo" ]; then
    echo "Usage: ghr remove <owner/repo>" >&2
    return 1
  fi

  local manifest
  manifest=$(manifest_read)
  local entry
  entry=$(echo "$manifest" | jq -r --arg repo "$repo" '.[] | select(.repo == $repo)')

  if [ -z "$entry" ]; then
    echo "$repo not in manifest" >&2
    return 1
  fi

  local dst
  while IFS= read -r dst; do
    [ -z "$dst" ] && continue
    if rm -f "$dst" 2>/dev/null || sudo rm -f "$dst"; then
      echo "Removed symlink: $dst"
    else
      echo "Failed to remove: $dst" >&2
    fi
  done < <(echo "$entry" | jq -r '.links | values[]')

  local dir
  dir=$(get_dir "$repo")
  rm -rf "$dir"

  echo "$manifest" | jq --arg repo "$repo" '[.[] | select(.repo != $repo)] | sort_by(.repo)' | manifest_write

  echo "Removed $repo"
}

list_all() {
  local symlink_map=""
  [ -f "$MANIFEST" ] && symlink_map=$(jq -r '.[] | "\(.repo)\t\(.links | values | join(", "))"' "$MANIFEST")

  # Every cached tool costs up to three requests, thanks to the retry loop below.
  local cached
  cached=$(find "$CACHE_DIR" -maxdepth 2 -name .repo -type f | wc -l)
  ensure_quota $((cached * 3))

  # shellcheck disable=SC2016
  (
    printf '%s\n' "$CACHE_DIR"/* | xargs -P3 -I{} bash -c '
      dir="$1"
      symlink_map="$2"
      [ -f "$dir/.repo" ] || exit
      repo=$(cat "$dir/.repo")
      local_ver=$(cat "$dir/.version")
      remote_ver=""
      for attempt in 1 2 3; do
        remote_ver=$(gh_api "$repo/releases/latest" | jq -r ".tag_name")
        [ -n "$remote_ver" ] && [ "$remote_ver" != "null" ] && break
        [ "$attempt" -lt 3 ] && sleep $((attempt * 2))
      done
      [ -z "$remote_ver" ] || [ "$remote_ver" = "null" ] && remote_ver="?"
      symlink=$(echo "$symlink_map" | grep "^$repo	" | cut -f2)
      [ -z "$symlink" ] && symlink="-"
      printf "%s\t%s\t%s\t%s\n" "$repo" "$local_ver" "$remote_ver" "$symlink"
    ' _ {} "$symlink_map"
  ) | sort -t$'\t' -k1,1 | awk -F'\t' '
    BEGIN { printf "%-30s  %-15s  %-15s  %s\n", "REPO", "INSTALLED", "LATEST", "SYMLINK" }
    $2 != $3 { printf "\033[33m%-30s  %-15s  %-15s  %s\033[0m\n", $1, $2, $3, $4; next }
    { printf "%-30s  %-15s  %-15s  %s\n", $1, $2, $3, $4 }
  '
}

main() {
  case "$1" in
  install | i) install_repo "$2" ;;
  update | u)
    if [ -n "$2" ]; then
      update_repo "$2"
    else
      restore_all quiet
    fi
    ;;
  restore | r) restore_all ;;
  remove | rm) remove_repo "$2" ;;
  list | ls) list_all ;;
  *) echo "Usage: ghr <install|update|restore|remove|list> [owner/repo]" >&2 ;;
  esac
}

main "$@"

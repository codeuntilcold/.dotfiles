#!/usr/bin/env python3
"""Streaming Markdown highlighter for terminal output.

Reads Markdown from stdin and emits ANSI-colored output to stdout. Designed
to handle character-level streaming where chunk boundaries may split tokens.

Recognized features: fenced code blocks (``` / ~~~), ATX headings (# .. ######),
inline code (`x`), bold (**x**/__x__), italic (*x*/_x_), and <think>...</think> blocks.
"""

import codecs
import os
import sys

ESC = "\033["
RESET, HEADR, FENCE, CODE, ICOD, THINK, BOLD, ITAL = (
    f"{ESC}0m", f"{ESC}96m", f"{ESC}33m", f"{ESC}92m",
    f"{ESC}95m", f"{ESC}90m", f"{ESC}1m", f"{ESC}3m",
)

OPEN_THINK, CLOSE_THINK = "<think>", "</think>"

LINE_NORMAL, LINE_HEADING, LINE_FENCE_OPEN = "normal", "heading", "fence_open"


# Pure functional core (no I/O, no mutation) — the Highlighter class below
# is the imperative shell that feeds it accumulated line-prefix chars.


def _leading_run(chars, ch):
    return len(chars) - len("".join(chars).lstrip(ch))


def classify_line(chars):
    """Decide a line's mode from its chars so far; None means not yet decidable."""
    c0 = chars[0]
    if c0 == "#":
        i = _leading_run(chars, "#")
        if i > 6:
            return LINE_NORMAL, None
        if i == len(chars):
            return None
        return (LINE_HEADING if chars[i] == " " else LINE_NORMAL), None
    if c0 in ("`", "~"):
        i = _leading_run(chars, c0)
        if i >= 3:
            return LINE_FENCE_OPEN, (c0, i)
        if i == len(chars):
            return None
        return LINE_NORMAL, None
    return LINE_NORMAL, None


def is_fence_close(line, fence_char, fence_len):
    stripped = line.rstrip()
    return set(stripped) == {fence_char} and len(stripped) >= fence_len


def _is_word(ch):
    return ch is not None and (ch.isalnum() or ch == "_")


def _word_boundary_ok(marker, left, next_ch=None):
    # Only '_' is boundary-gated (avoids snake_case/dunder false triggers).
    # next_ch is omitted for bold opens, which have no lookahead available.
    if marker != "_":
        return True
    if next_ch is not None and next_ch.isspace():
        return False
    return not _is_word(left)


class Highlighter:
    def __init__(self, out=None):
        self.out = out if out is not None else sys.stdout

        self.in_fence = self.fence_run_open = self.in_think = False
        self.fence_char, self.fence_len = None, 0

        self.line_chars = []
        self.line_decided = False
        self.line_mode = LINE_NORMAL

        self.in_inline_code = False
        self.bold_marker = self.italic_marker = self.pending = self.prev_ch = None
        self.tag_buf = ""

    # ---------------------------------------------------------------- API
    def feed(self, text):
        if not text:
            return
        for ch in text:
            self._process(ch)

    def flush(self):
        if self.line_chars or self.tag_buf or self.pending:
            self._end_line(emit_newline=False)
        else:
            self._close_inline_styles()
        if self.in_think:
            self._w(RESET)
            self.in_think = False
        try:
            self.out.flush()
        except Exception:
            pass

    # ----------------------------------------------------------- internals
    def _w(self, s):
        self.out.write(s)

    def _process(self, ch):
        if ch == "\n":
            self._end_line()
            return

        if self.in_fence:
            self.line_chars.append(ch)
            return

        if self.in_think:
            self._inline(ch)
            return

        if not self.line_decided:
            self.line_chars.append(ch)
            self._try_classify_line()
            if self.line_decided:
                buf, self.line_chars = "".join(self.line_chars), []
                self._begin_decided_line(buf)
            return

        if self.line_mode == LINE_NORMAL:
            self._inline(ch)
            return

        if self.line_mode == LINE_FENCE_OPEN and self.fence_run_open:
            if ch == self.fence_char:
                self.fence_len += 1
            else:
                self.fence_run_open = False
        self._w(ch)

    # ------------------------------------------------- line classification
    def _try_classify_line(self):
        result = classify_line(self.line_chars)
        if result is None:
            return
        mode, fence_info = result
        if fence_info:
            self.fence_char, self.fence_len = fence_info
        self._decide(mode)

    def _decide(self, mode):
        self.line_mode = mode
        self.line_decided = True

    def _begin_decided_line(self, buf):
        if self.line_mode == LINE_HEADING:
            self._w(HEADR + buf)
        elif self.line_mode == LINE_FENCE_OPEN:
            self.fence_run_open = len(buf) == self.fence_len
            self._w(FENCE + buf)
        else:
            for c in buf:
                self._inline(c)

    # -------------------------------------------------------- end of line
    def _end_line(self, emit_newline=True):
        if self.in_fence:
            line, self.line_chars = "".join(self.line_chars), []
            if is_fence_close(line, self.fence_char, self.fence_len):
                self._w(FENCE + line + RESET)
                self.in_fence = False
            else:
                self._w(CODE + line + RESET)
            if emit_newline:
                self._w("\n")
            return

        self._flush_pending_literals()

        # <think> spans newlines: preserve bold_marker/italic_marker and the
        # THINK color across the boundary so they restore on </think>.
        if not self.in_think:
            self._close_inline_styles()
            if not self.line_decided:
                self._w("".join(self.line_chars))
            if self.line_mode in (LINE_HEADING, LINE_FENCE_OPEN):
                self._w(RESET)
            if self.line_mode == LINE_FENCE_OPEN:
                self.in_fence = True

        if emit_newline:
            self._w("\n")

        self.line_decided = False
        self.line_mode, self.line_chars, self.prev_ch = LINE_NORMAL, [], None

    # ----------------------------------------------------- inline machine
    def _inline(self, ch):
        prev, self.prev_ch = self.prev_ch, ch

        if self.in_inline_code:
            if ch == "`":
                self._w("`" + RESET)
                self.in_inline_code = False
                return
            self._w(ch)
            return

        if self.tag_buf or ch == "<":
            candidate = self.tag_buf + ch
            if candidate == OPEN_THINK:
                self.tag_buf = ""
                # Drop any active inline styles around the tag so THINK reads cleanly
                if self.bold_marker or self.italic_marker:
                    self._w(RESET)
                self._w(THINK + OPEN_THINK)
                self.in_think = True
                return
            if candidate == CLOSE_THINK:
                self.tag_buf = ""
                self._w(CLOSE_THINK + RESET)
                self.in_think = False
                # Restore any inline styles that were active before the tag
                if self.bold_marker:
                    self._w(BOLD)
                if self.italic_marker:
                    self._w(ITAL)
                return
            if OPEN_THINK.startswith(candidate) or CLOSE_THINK.startswith(candidate):
                self.tag_buf = candidate
                return
            # Tag mismatch: emit accumulated chars as literal text
            self._w(self.tag_buf)
            self.tag_buf = ""
            if ch == "<":
                self.tag_buf = "<"
                return

        if self.in_think:
            self._w(ch)
            return

        if ch in ("*", "_"):
            if self.pending:
                if self.pending[0] == ch:
                    self._toggle_bold(ch, self.pending[1])
                    self.pending = None
                    return
                self._resolve_pending(ch)
            self.pending = (ch, prev)
            return

        self._resolve_pending(ch)

        if ch == "`":
            self._w(ICOD + "`")
            self.in_inline_code = True
            return

        self._w(ch)

    def _toggle_bold(self, marker, left):
        # Closing is checked before the boundary rule, so a style can never
        # get stuck on regardless of what follows it (here and in _resolve_pending).
        if self.bold_marker == marker:
            self._w(marker * 2 + RESET)
            self.bold_marker = None
        elif self.bold_marker or not _word_boundary_ok(marker, left):
            self._w(marker * 2)
        else:
            self._w(BOLD + marker * 2)
            self.bold_marker = marker

    def _resolve_pending(self, next_ch):
        if self.pending is None:
            return
        marker, left = self.pending
        self.pending = None
        if self.italic_marker == marker:
            self._w(marker + RESET)
            self.italic_marker = None
        elif self.bold_marker or self.italic_marker or not _word_boundary_ok(marker, left, next_ch):
            self._w(marker)
        else:
            self._w(ITAL + marker)
            self.italic_marker = marker

    def _flush_pending_literals(self):
        if self.tag_buf:
            self._w(self.tag_buf)
            self.tag_buf = ""
        if self.pending:
            self._w(self.pending[0])
            self.pending = None

    def _close_inline_styles(self):
        if self.in_inline_code or self.bold_marker or self.italic_marker:
            self._w(RESET)
            self.in_inline_code = False
            self.bold_marker = None
            self.italic_marker = None


# ----------------------------------------------------------------- main


def _run():
    h = Highlighter()
    decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
    fd = 0
    try:
        while True:
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            text = decoder.decode(chunk)
            if text:
                h.feed(text)
                sys.stdout.flush()
        tail = decoder.decode(b"", final=True)
        if tail:
            h.feed(tail)
        h.flush()
    except KeyboardInterrupt:
        h.flush()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        try:
            sys.stderr.close()
        except Exception:
            pass


if __name__ == "__main__":
    _run()
